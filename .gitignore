# autosync runtime files (never committed)
.autosync/*.log
.autosync/*.lock
.autosync/state/

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# common build/dependency dirs
node_modules/
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
.env
.env.local

# Local SQLite database
prisma/dev.db
prisma/dev.db-journal
# Copies taken before a migration. Same real data as dev.db, so they must
# never be committed either.
prisma/dev.db.backup-*
.probe-profiles/

# Verification builds, kept apart from the dev server output.
.next-verify/

# Uploaded charger photos — user content, not source.
public/uploads/

# Playwright screenshots — output, not source.
.screenshots/
test-results/
playwright-report/
