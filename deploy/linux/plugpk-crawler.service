# deploy/linux/plugpk-crawler.service
#
# The daily crawl, as a oneshot unit. Started by plugpk-crawler.timer, never
# enabled on its own.
#
# Install (as root), after editing the three paths and the user below:
#
#   cp deploy/linux/plugpk-crawler.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl start plugpk-crawler.service        # run once, now, and watch it
#   journalctl -u plugpk-crawler -f
#
# NOTHING IS SCHEDULED until the timer is enabled, which is a separate command
# documented in the timer file. Starting this unit runs one crawl and stops.

[Unit]
Description=PlugPK daily EV data crawl (files proposals; never writes the catalogue)
Documentation=file:///srv/plugpk/docs/CRAWLER.md
# Requires the network to be genuinely up, not merely configured. Without this a
# boot-time run races DNS and records a failure against every source, which then
# puts them all into backoff for a problem that was ours.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

# ── Edit these three ─────────────────────────────────────────────────
User=plugpk
Group=plugpk
WorkingDirectory=/srv/plugpk

# The environment file holds DATABASE_URL and any source credentials. Referenced
# rather than inlined: an Environment= line in a unit file is world-readable
# through `systemctl show`, and a secret in a unit file is a secret in every
# operator's shell history.
EnvironmentFile=/etc/plugpk/crawler.env

ExecStart=/usr/bin/npm run crawl:daily

# Four hours, then killed. A crawl still going after that has hung, and an open
# CrawlRun holds no lock and writes nothing to the catalogue - the row simply
# stays, and /admin/cars/updates reports it as unfinished rather than tidying the
# interruption away.
TimeoutStartSec=4h

# ── Hardening ────────────────────────────────────────────────────────
#
# This process reaches the public internet and writes to a database. Everything
# below is the standard set for something in that position, and each line is here
# because a crawler is exactly the kind of process that should not be able to do
# the thing it forbids.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

# ProtectSystem=strict makes everything read-only, so the two paths that must be
# writable are named. The database directory, and nothing else under the checkout:
# a crawler has no business writing to its own source tree.
ReadWritePaths=/srv/plugpk/prisma
ReadWritePaths=/srv/plugpk/logs

# IPv4 and IPv6 only. A crawler has no reason to speak any other address family,
# and this closes off unix-socket access to anything it should not be reaching.
RestrictAddressFamilies=AF_INET AF_INET6

# Output goes to the journal, which is where an operator will look for it and
# where retention is already somebody else's solved problem.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plugpk-crawler

[Install]
# Deliberately no WantedBy. This unit is started by its timer; enabling it
# directly would run one crawl at every boot, which is not a schedule.
