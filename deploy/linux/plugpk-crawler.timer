# deploy/linux/plugpk-crawler.timer
#
# When the daily crawl runs.
#
# ── This is the activation switch on a Linux host ─────────────────────
#
# Copying this file schedules nothing. One command does:
#
#   systemctl enable --now plugpk-crawler.timer
#
# And one command undoes it:
#
#   systemctl disable --now plugpk-crawler.timer
#
# Check it without guessing:
#
#   systemctl list-timers plugpk-crawler.timer
#   journalctl -u plugpk-crawler --since yesterday
#
# ── Why a timer rather than cron ──────────────────────────────────────
#
# Three things cron does not give, each of which has cost somebody a silent
# outage:
#
#   Persistent=true      a machine that was off at 06:00 runs the crawl when it
#                        comes back, instead of skipping the day with no trace.
#                        cron simply misses it.
#   RandomizedDelaySec   spreads the start, so this is not one more job hitting a
#                        public dataset at exactly the top of the hour.
#   the journal          `journalctl -u plugpk-crawler` is the whole history,
#                        already rotated, instead of a redirect to a file that
#                        somebody has to remember to prune.
#
# A crontab is still provided in crontab.example for hosts without systemd.

[Unit]
Description=Run the PlugPK EV data crawl daily
Documentation=file:///srv/plugpk/docs/CRAWLER.md

[Timer]
# 06:00 local time. Not midnight: that is when every scheduled job on the
# internet fires, so a public dataset is at its slowest and quickest to
# rate-limit precisely then. 06:00 also finishes before anybody opens the review
# queue, and keeps the run inside one calendar day so "today's crawl" on the
# dashboard means what it says.
OnCalendar=*-*-* 06:00:00

# Up to twenty minutes of jitter, for the reason above.
RandomizedDelaySec=20m

# A missed run is made up, once, on the next boot rather than being lost.
Persistent=true

# Never two crawls at once against one SQLite file. systemd will not start a
# second instance of a oneshot unit that is still running, and this makes the
# timer wait rather than fail.
AccuracySec=1m

[Install]
WantedBy=timers.target
