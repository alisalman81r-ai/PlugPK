# Database — SQLite file, created by `npx prisma migrate dev`
DATABASE_URL="file:./dev.db"

# ── Admin portal ────────────────────────────────────────────────
# Both are required. Without ENABLE_ADMIN the /admin routes return 404,
# exactly like any unknown path, so the portal cannot leak into a
# production deploy by accident.
#
#   ENABLE_ADMIN    whether /admin exists at all
#   ADMIN_PASSWORD  the shared credential, checked server-side
#
# ENABLE_ADMIN=true
# ADMIN_PASSWORD=choose-something-long

# Optional. Without a key the map renders on MapLibre + OpenFreeMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── Real station data ───────────────────────────────────────────
# Free key: https://openchargemap.org/site/develop/api
# With it set, "npm run import:stations" pulls real Pakistani charging
# stations into the database. Without it, stations are added by hand at
# /admin/stations. Nothing is ever generated — see scripts/import-stations.ts.
OPENCHARGEMAP_API_KEY=

# ── Sessions ────────────────────────────────────────────────────
# Signs the login cookie for business owners. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Falls back to ADMIN_PASSWORD in development only. Set it for real
# deployments — sharing one secret means one leak compromises both.
SESSION_SECRET=
