# Database — SQLite file, created by `npx prisma migrate dev`
DATABASE_URL="file:./dev.db"

# ── Admin portal ────────────────────────────────────────────────
# Both are required. Without ENABLE_ADMIN the /admin routes return 404,
# exactly like any unknown path, so the portal cannot leak into a
# production deploy by accident.
#
#   ENABLE_ADMIN    whether /admin exists at all
#   ADMIN_PASSWORD  the shared credential, checked server-side
#
# ENABLE_ADMIN=true
# ADMIN_PASSWORD=choose-something-long

# Optional. Without a key the map renders on MapLibre + OpenFreeMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
