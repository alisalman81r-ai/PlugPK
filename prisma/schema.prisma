// prisma/schema.prisma
//
// Mirrors the interfaces in src/lib/types.ts so the mapping layer in
// src/lib/db/ can hand components exactly the shapes they already expect —
// no component had to change to move off mock-data.ts.
//
// Two shape decisions worth stating:
//
//   Connector and Review are real tables, not embedded JSON, because the
//   admin edits them individually — a port count changing is the single most
//   common write this product will ever do.
//
//   amenities, operatingHours, photos and compatibleVehicles are stored as
//   JSON text. They are always read and written whole, never queried into,
//   so normalising them would buy nothing and cost four more joins per
//   station. The helpers in src/lib/db/serialize.ts are the only place that
//   parses them.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Station {
  id          String  @id
  slug        String  @unique
  name        String
  description String?

  // Address, flattened. Queried by city on the map and services pages.
  street     String
  area       String
  city       String
  province   String
  country    String
  postalCode String?

  lat Float
  lng Float

  // JSON text — see the note at the top of this file.
  amenities      String @default("[]")
  operatingHours String @default("{}")
  photos         String @default("[]")

  coverPhoto  String?
  rating      Float   @default(0)
  reviewCount Int     @default(0)
  status      String  @default("unknown")
  isVerified  Boolean @default(false)
  network     String  @default("")
  phone       String?
  website     String?
  businessId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectors Connector[]
  reviews    Review[]

  @@index([city])
  @@index([status])
}

/**
 * A physical charging unit at a station.
 * Carries no pricing. Rates are set by each operator and change often, and a
 * stale figure shown as fact is worse than no figure at all — a driver who
 * arrives expecting one price and is charged another loses trust in the whole
 * map. Businesses are asked to discuss terms through a meeting request
 * instead.
 */
model Connector {
  id                 String @id
  stationId          String
  type               String
  maxPowerKw         Float
  ports              Int
  availablePorts     Int
  status             String @default("available")
  compatibleVehicles String @default("[]")

  // Deleting a station takes its connectors with it. A connector without a
  // station is meaningless, and leaving orphans would corrupt every port
  // count the product displays.
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId])
}

model Review {
  id           String   @id
  /**
   * A review belongs to exactly one of a station or a business.
   * Both are nullable because listings come from two tables: stations entered
   * by an operator, and businesses that applied through the public form. Before
   * this, a business could be shown on the map but never reviewed — the owner's
   * reviews page had nowhere to read from and showed invented figures instead.
   */
  stationId    String?
  businessId   String?
  userId       String
  userName     String
  userAvatar   String?
  userVehicle  String
  rating       Int
  comment      String
  photos       String   @default("[]")
  date         DateTime @default(now())
  helpfulCount Int      @default(0)
  isVerified   Boolean  @default(false)

  station  Station?  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@index([businessId])
}

/**
 * One row per business per day, counting what actually happened.
 * The analytics page used to read a fixed array — 1,240 views and 89 clicks
 * that never moved, for a listing that may not even have been approved. These
 * counters are incremented by real visits to the public listing page and real
 * presses of its directions button, so a quiet listing correctly reads zero.
 * Stored per day rather than as a running total because the page charts a time
 * series and compares this month against last.
 */
model BusinessDailyStat {
  id         String @id
  businessId String
  /**
   * Calendar day in Pakistan Standard Time, as YYYY-MM-DD.
   */
  day        String
  views      Int    @default(0)
  clicks     Int    @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
  @@index([businessId])
}

model EVService {
  id          String @id
  slug        String @unique
  name        String
  category    String
  description String

  street     String
  area       String
  city       String
  province   String
  country    String
  postalCode String?

  lat Float
  lng Float

  phone      String
  email      String?
  website    String?
  photos     String  @default("[]")
  coverPhoto String?

  rating         Float   @default(0)
  reviewCount    Int     @default(0)
  operatingHours String  @default("{}")
  isVerified     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([category])
  @@index([city])
}

model CommunityPost {
  id           String   @id
  slug         String   @unique
  userId       String
  userName     String
  userAvatar   String?
  userVehicle  String?
  title        String
  content      String
  category     String
  photos       String   @default("[]")
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comments Comment[]

  @@index([category])
}

model Comment {
  id         String   @id
  postId     String
  userId     String
  userName   String
  userAvatar String?
  content    String
  likeCount  Int      @default(0)
  createdAt  DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/**
 * A registered EV owner.
 * Exists so the "EV owners" figure on the homepage counts something real. It
 * is a registration record, not a full auth system — there are no sessions,
 * roles or password resets here yet. What it does guarantee is that a
 * password never touches the database in readable form: signUp stores a
 * scrypt hash with a per-user salt and nothing else.
 */
model User {
  id           String   @id
  email        String   @unique
  name         String
  city         String?
  vehicle      String?
  /**
   * Path to an uploaded profile picture, e.g. /uploads/avatars/<id>.jpg.
   */
  avatar       String?
  passwordHash String
  createdAt    DateTime @default(now())

  businesses Business[]
  saved      SavedStation[]
  vehicles   UserVehicle[]
  clubs      ClubMember[]

  @@index([createdAt])
}

/**
 * A listing somebody bookmarked.
 * The bookmark button on a station page used to toggle React state and nothing
 * else, so the dashboard's "Saved" tab could only ever show a fixture's three
 * saved stations to everyone who opened it.
 * `listingId` is a plain string rather than a foreign key because the map
 * carries two kinds of listing — stations entered by an operator and approved
 * businesses — and a driver saving one should not have to care which table it
 * came from. Rows whose listing later disappears are filtered out on read.
 */
model SavedStation {
  id        String   @id
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

/**
 * A business asking to talk to the team.
 * Replaces the published subscription tiers. Stored rather than emailed so
 * requests cannot be lost in an inbox and can be worked through in the admin
 * portal.
 */
model MeetingRequest {
  id            String   @id
  name          String
  company       String
  email         String
  phone         String?
  preferredDate String?
  preferredTime String?
  note          String?
  /**
   * new | handled — deliberately a string, not an enum, so SQLite stays simple.
   */
  status        String   @default("new")
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

/**
 * A business that applied to list its chargers on the platform.
 * Before this, the sign-up form waited 2.5 seconds and showed "You're Live on
 * Plug.pk!" without writing anything — every application was lost the moment
 * the page was refreshed.
 * The password the form collects is deliberately NOT stored here. Keeping a
 * plaintext password in an application record would be indefensible, and
 * hashing one into a table that is not the account table would just be a
 * second, worse copy of User. Applying and holding an account are separate
 * concerns; the account is created through registerUser.
 */
model Business {
  id           String   @id
  /**
   * The account that submitted this listing.
   * Nullable because an operator can enter a business directly in the admin
   * portal, and that record has no owner account behind it. When the public
   * form is used, a User is created and linked here — which is what lets the
   * business dashboard show the owner their own listing rather than a mock.
   */
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ownerName    String
  email        String
  phone        String?
  businessName String
  /**
   * hotel | restaurant | mall | office | dealership | service-center
   */
  businessType String
  city         String
  address      String?
  website      String?
  /**
   * Free text the owner writes for their public listing.
   */
  description  String?
  /**
   * Where the chargers actually are.
   * Nullable because a city and a street line are not a position — an
   * application submitted without coordinates can still be reviewed, it just
   * cannot be put on the map. Only approved businesses that have both values
   * become map pins.
   */
  lat          Float?
  lng          Float?
  /**
   * JSON array of { connectorType, maxPowerKw, ports } from the form.
   */
  chargers     String   @default("[]")
  /**
   * pending | approved | rejected — a string, not an enum, so SQLite stays simple.
   */
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  reviews    Review[]
  dailyStats BusinessDailyStat[]

  @@index([status])
  @@index([createdAt])
}

/**
 * The Pakistan EV / PHEV / EREV catalogue.
 * Was a 145-row TypeScript module in src/data/pakistanVehicles.ts, which meant
 * adding a car needed a deploy and nothing could ever reference one by foreign
 * key. The module stays as the seed source — it is a readable, reviewable
 * record of where the list came from — but this table is what the application
 * reads.
 * Identity is required; every specification is nullable, and that is the whole
 * design. A range figure is what a driver plans a 400km trip on, so a column
 * stays NULL until somebody verifies the number rather than holding a
 * plausible guess. Eight rows have verified figures today; the other 137 are
 * honestly empty.
 * `connectors` is a comma-separated string because SQLite has no array type.
 * Read it through serialize.ts rather than splitting it at each call site.
 */
model Vehicle {
  /**
   * Kebab-case, e.g. "byd-atto-3" — stable, so it can appear in a URL.
   */
  id           String @id
  brand        String
  model        String
  /**
   * BEV | PHEV | EREV — a string, not an enum, so SQLite stays simple.
   */
  powertrain   String
  /**
   * official | imported | rare-import
   */
  availability String
  bodyType     String

  // ─── Verified figures. Null means unknown, never zero. ───
  modelYear          Int?
  rangeKm            Int?
  batteryCapacityKwh Float?
  /**
   * Comma-separated ConnectorType values, e.g. "CCS2,Type2".
   */
  connectors         String?
  dcChargingKw       Int?
  acChargingKw       Int?
  pricePkr           Int?
  imageUrl           String?

  createdAt DateTime @default(now())

  owners UserVehicle[]

  @@index([brand])
  @@index([powertrain])
  @@index([availability])
}

/**
 * A car somebody actually owns.
 * The dashboard has had an "add vehicle" screen for a while with nowhere to
 * put the answer, so a car added there survived until the next navigation.
 * User.vehicle is still there and still free text — it is what signup collects
 * in one box — and this is the structured version, pointing at a catalogue row.
 */
model UserVehicle {
  id           String   @id
  userId       String
  vehicleId    String
  /**
   * What the owner calls it, e.g. "My BYD".
   */
  customName   String?
  color        String?
  licensePlate String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@unique([userId, vehicleId])
  @@index([userId])
}

/**
 * An owners' club.
 * The home page and the clubs directory both render these, and both were
 * reading a fixture — so "234 members" was the same number for everyone,
 * forever, and Join did nothing that survived a refresh.
 * memberCount is stored rather than counted from ClubMember because the seeded
 * figures are historical totals from before this table existed; counting rows
 * would have shown every club dropping to zero. getClubs() returns the stored
 * figure plus real joins.
 */
model Club {
  id          String   @id
  name        String
  city        String
  description String
  coverPhoto  String?
  /**
   * Baseline total. Real joins live in ClubMember and are added on read.
   */
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())

  members ClubMember[]

  @@index([city])
}

model ClubMember {
  id       String   @id
  clubId   String
  userId   String
  joinedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

/// The electrified car catalogue.
///
/// Moved here from src/data/cars.ts, which is now the seed rather than the
/// source: the admin needs to edit every field, and a TypeScript module
/// compiled into the bundle cannot be written to at runtime — a production
/// filesystem is read-only, and the module the server holds is the compiled
/// one, so a successful write would change a file nobody reads until the next
/// build.
///
/// Every measured column is nullable, which is the whole point. The data
/// module's first rule is that nothing is invented: a car with no published DC
/// figure stores null, never a plausible number, and the admin form has to be
/// able to write that null back.
///
/// price is three columns rather than JSON because the catalogue sorts and
/// filters on the numbers, and `display` has to survive verbatim — "PKR 1.0649
/// Cr" is not recomputed from 10,649,000, and an indicative price carries its
/// own "(indicative)" marker inside that string.
///
/// connectors is a comma-separated string. SQLite has no array type, the value
/// is always read and written whole, and there are at most four of them; a join
/// table would cost a query per car to buy nothing.
model Car {
  id       String @id
  slug     String @unique
  brand    String
  model    String
  fullName String
  category String

  priceMin     Int
  priceMax     Int
  priceDisplay String

  batteryCapacity  Float?
  range            Int?
  rangeMax         Int?
  electricRange    Int?
  electricRangeMax Int?

  power        Int?
  acceleration Float?
  topSpeed     Int?
  torque       Int?
  seats        Int?

  dcCharging Float?
  acCharging Float?
  connectors String @default("")

  engineCapacity Int?

  image String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Staging rows that have been matched to this car. Read-only evidence:
  /// nothing here writes to Car, and deleting a Car nulls the link rather
  /// than destroying what a source said.
  sourceRecords CarSourceRecord[]

  @@index([category])
  @@index([brand])
}

/**
 * ─── Crawler staging ──────────────────────────────────────────────────
 * Two tables that sit beside the catalogue and never inside it.
 * Crawled data does not go into Car. The catalogue's governing rule is that
 * nothing in it is invented, and a scraped figure is not a verified one — write
 * it straight into Car and a guess becomes indistinguishable from a supplied
 * price. So a crawl lands here, an operator reviews it, and only an approved
 * record is ever applied to a Car through the existing validated write path.
 * It also means several sources can disagree about the same car and both
 * answers survive, which a single Car row cannot express.
 */

/**
 * A provider of car data.
 * Disabled by default. Enabling a source is a decision with legal weight —
 * somebody has to have read its terms and checked its robots.txt — so the
 * schema makes that an explicit act rather than the default state.
 */
model CarSource {
  /// Kebab-case and hand-set, e.g. "pakwheels", matching the rest of this schema.
  id      String @id
  name    String @unique
  baseUrl String

  /// unchecked | allowed | disallowed | unreachable — see crawler/robots.ts.
  /// A source may only be crawled while this reads "allowed".
  robotsStatus    String    @default("unchecked")
  robotsCheckedAt DateTime?
  /// The matching robots.txt line, kept so a refusal can be justified later.
  robotsNote      String?

  /// 0–100. Higher wins when two sources disagree about the same field.
  /// A rank, not a certainty: it orders sources, it does not validate them.
  trustRank Int @default(50)

  /// How often this source may be re-crawled, and the pause between requests.
  crawlIntervalMinutes Int       @default(1440)
  requestDelayMs       Int       @default(1500)
  lastCrawledAt        DateTime?

  /// Off until somebody turns it on deliberately.
  isEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records CarSourceRecord[]

  @@index([isEnabled])
}

/**
 * One page, from one source, as read on one crawl run.
 * ── The unique constraint, and what it deliberately does not assume ───
 * `@@unique([sourceId, sourceUrl, runId])`.
 * A source's car name is not unique, its slug is not unique, and neither is
 * safe as an identity — two sources will both call something "Atto 3", and one
 * source may list the same car under several names. The only thing that
 * identifies a page is its URL, and only within the source that served it.
 * `runId` is in the key on purpose: it makes re-crawls accumulate as history
 * rather than overwrite, so "this price changed last Tuesday" is answerable,
 * while a run that visits the same URL twice still cannot insert it twice.
 */
model CarSourceRecord {
  id String @id

  sourceId String
  source   CarSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// The exact page this was read from.
  sourceUrl  String
  /// The source's own identifier, when it publishes one. Never assumed present,
  /// never assumed unique across sources.
  externalId String?

  /// Groups every record produced by a single crawl.
  runId      String
  fetchedAt  DateTime
  httpStatus Int?

  /// ScrapedCar, as JSON text — SQLite has no JSON column, and this project
  /// already stores whole-read blobs this way (see serialize.ts).
  raw         String
  /// NormalisedCar, as JSON text. Null when normalisation could not run.
  normalised  String?
  /// Hash of `raw`, so an unchanged re-crawl is recognisable without a diff.
  contentHash String

  /// ok | partial | failed
  extractionStatus String @default("ok")
  fieldsFound      Int    @default(0)
  fieldsExpected   Int    @default(0)
  /// 0–100, derived from field coverage and how the values were obtained.
  confidence       Int    @default(0)

  /// pending | approved | rejected | superseded | duplicate
  reviewStatus String    @default("pending")
  reviewedAt   DateTime?
  reviewNote   String?

  /// Set only by the matcher, and only ever as a proposal. Phase 1 never
  /// applies a record to a Car.
  matchedCarId    String?
  matchedCar      Car?    @relation(fields: [matchedCarId], references: [id], onDelete: SetNull)
  /// external-id | slug | exact | strong | none — see crawler/match.ts.
  matchStrategy   String?
  matchScore      Int?
  /// Serialised rival candidates, so an ambiguous match can be reviewed rather
  /// than silently resolved.
  matchCandidates String?

  /// Why extraction or normalisation failed, when it did.
  errorMessage String?
  /// Field names that could not be read, as JSON text.
  errorFields  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, sourceUrl, runId])
  @@index([sourceId, externalId])
  @@index([reviewStatus, fetchedAt])
  @@index([matchedCarId, fetchedAt])
  @@index([runId])
  @@index([contentHash])
}

/**
 * One execution of one source's crawl.
 * `CarSourceRecord.runId` holds this id, but deliberately as a plain string
 * rather than a foreign key. Adding a real relation would mean altering
 * CarSourceRecord, and the standing constraint on this project is that crawler
 * migrations stay additive — a CREATE TABLE cannot damage a live catalogue, an
 * ALTER can. The cost is that a run row could in principle be deleted while its
 * records remain; the records are the valuable half, so that is the right way
 * round.
 */
model CrawlRun {
  id       String @id
  sourceId String

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// running | completed | failed | aborted | blocked
  /// "blocked" is its own outcome, not a failure: it means robots.txt or a
  /// missing credential stopped the run before a single request went out, which
  /// is the system working rather than breaking.
  status String @default("running")

  recordsFound  Int @default(0)
  recordsStored Int @default(0)
  recordsFailed Int @default(0)

  /// Collected failures as JSON text, so one bad page does not lose the run.
  errors String?
  notes  String?

  @@index([sourceId, startedAt])
  @@index([status])
}
