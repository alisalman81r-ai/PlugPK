// prisma/schema.prisma
//
// Mirrors the interfaces in src/lib/types.ts so the mapping layer in
// src/lib/db/ can hand components exactly the shapes they already expect —
// no component had to change to move off mock-data.ts.
//
// Two shape decisions worth stating:
//
//   Connector and Review are real tables, not embedded JSON, because the
//   admin edits them individually — a port count changing is the single most
//   common write this product will ever do.
//
//   amenities, operatingHours, photos and compatibleVehicles are stored as
//   JSON text. They are always read and written whole, never queried into,
//   so normalising them would buy nothing and cost four more joins per
//   station. The helpers in src/lib/db/serialize.ts are the only place that
//   parses them.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Station {
  id          String  @id
  slug        String  @unique
  name        String
  description String?

  // Address, flattened. Queried by city on the map and services pages.
  street     String
  area       String
  city       String
  province   String
  country    String
  postalCode String?

  lat Float
  lng Float

  // JSON text — see the note at the top of this file.
  amenities      String @default("[]")
  operatingHours String @default("{}")
  photos         String @default("[]")

  coverPhoto  String?
  rating      Float   @default(0)
  reviewCount Int     @default(0)
  status      String  @default("unknown")
  isVerified  Boolean @default(false)
  network     String  @default("")
  phone       String?
  website     String?
  businessId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectors Connector[]
  reviews    Review[]

  @@index([city])
  @@index([status])
}

/**
 * A physical charging unit at a station.
 * Carries no pricing. Rates are set by each operator and change often, and a
 * stale figure shown as fact is worse than no figure at all — a driver who
 * arrives expecting one price and is charged another loses trust in the whole
 * map. Businesses are asked to discuss terms through a meeting request
 * instead.
 */
model Connector {
  id                 String @id
  stationId          String
  type               String
  maxPowerKw         Float
  ports              Int
  availablePorts     Int
  status             String @default("available")
  compatibleVehicles String @default("[]")

  // Deleting a station takes its connectors with it. A connector without a
  // station is meaningless, and leaving orphans would corrupt every port
  // count the product displays.
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId])
}

model Review {
  id           String   @id
  /**
   * A review belongs to exactly one of a station or a business.
   * Both are nullable because listings come from two tables: stations entered
   * by an operator, and businesses that applied through the public form. Before
   * this, a business could be shown on the map but never reviewed — the owner's
   * reviews page had nowhere to read from and showed invented figures instead.
   */
  stationId    String?
  businessId   String?
  userId       String
  userName     String
  userAvatar   String?
  userVehicle  String
  rating       Int
  comment      String
  photos       String   @default("[]")
  date         DateTime @default(now())
  helpfulCount Int      @default(0)
  isVerified   Boolean  @default(false)

  station  Station?  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@index([businessId])
}

/**
 * One row per business per day, counting what actually happened.
 * The analytics page used to read a fixed array — 1,240 views and 89 clicks
 * that never moved, for a listing that may not even have been approved. These
 * counters are incremented by real visits to the public listing page and real
 * presses of its directions button, so a quiet listing correctly reads zero.
 * Stored per day rather than as a running total because the page charts a time
 * series and compares this month against last.
 */
model BusinessDailyStat {
  id         String @id
  businessId String
  /**
   * Calendar day in Pakistan Standard Time, as YYYY-MM-DD.
   */
  day        String
  views      Int    @default(0)
  clicks     Int    @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
  @@index([businessId])
}

model EVService {
  id          String @id
  slug        String @unique
  name        String
  category    String
  description String

  street     String
  area       String
  city       String
  province   String
  country    String
  postalCode String?

  lat Float
  lng Float

  phone      String
  email      String?
  website    String?
  photos     String  @default("[]")
  coverPhoto String?

  rating         Float   @default(0)
  reviewCount    Int     @default(0)
  operatingHours String  @default("{}")
  isVerified     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([category])
  @@index([city])
}

model CommunityPost {
  id           String   @id
  slug         String   @unique
  userId       String
  userName     String
  userAvatar   String?
  userVehicle  String?
  title        String
  content      String
  category     String
  photos       String   @default("[]")
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comments Comment[]

  @@index([category])
}

model Comment {
  id         String   @id
  postId     String
  userId     String
  userName   String
  userAvatar String?
  content    String
  likeCount  Int      @default(0)
  createdAt  DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/**
 * A registered EV owner.
 * Exists so the "EV owners" figure on the homepage counts something real. It
 * is a registration record, not a full auth system — there are no sessions,
 * roles or password resets here yet. What it does guarantee is that a
 * password never touches the database in readable form: signUp stores a
 * scrypt hash with a per-user salt and nothing else.
 */
model User {
  id           String   @id
  email        String   @unique
  name         String
  city         String?
  vehicle      String?
  /**
   * Path to an uploaded profile picture, e.g. /uploads/avatars/<id>.jpg.
   */
  avatar       String?
  passwordHash String
  createdAt    DateTime @default(now())

  businesses Business[]
  saved      SavedStation[]
  vehicles   UserVehicle[]
  clubs      ClubMember[]

  @@index([createdAt])
}

/**
 * A listing somebody bookmarked.
 * The bookmark button on a station page used to toggle React state and nothing
 * else, so the dashboard's "Saved" tab could only ever show a fixture's three
 * saved stations to everyone who opened it.
 * `listingId` is a plain string rather than a foreign key because the map
 * carries two kinds of listing — stations entered by an operator and approved
 * businesses — and a driver saving one should not have to care which table it
 * came from. Rows whose listing later disappears are filtered out on read.
 */
model SavedStation {
  id        String   @id
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

/**
 * A business asking to talk to the team.
 * Replaces the published subscription tiers. Stored rather than emailed so
 * requests cannot be lost in an inbox and can be worked through in the admin
 * portal.
 */
model MeetingRequest {
  id            String   @id
  name          String
  company       String
  email         String
  phone         String?
  preferredDate String?
  preferredTime String?
  note          String?
  /**
   * new | handled — deliberately a string, not an enum, so SQLite stays simple.
   */
  status        String   @default("new")
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

/**
 * A business that applied to list its chargers on the platform.
 * Before this, the sign-up form waited 2.5 seconds and showed "You're Live on
 * Plug.pk!" without writing anything — every application was lost the moment
 * the page was refreshed.
 * The password the form collects is deliberately NOT stored here. Keeping a
 * plaintext password in an application record would be indefensible, and
 * hashing one into a table that is not the account table would just be a
 * second, worse copy of User. Applying and holding an account are separate
 * concerns; the account is created through registerUser.
 */
model Business {
  id           String   @id
  /**
   * The account that submitted this listing.
   * Nullable because an operator can enter a business directly in the admin
   * portal, and that record has no owner account behind it. When the public
   * form is used, a User is created and linked here — which is what lets the
   * business dashboard show the owner their own listing rather than a mock.
   */
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ownerName    String
  email        String
  phone        String?
  businessName String
  /**
   * hotel | restaurant | mall | office | dealership | service-center
   */
  businessType String
  city         String
  address      String?
  website      String?
  /**
   * Free text the owner writes for their public listing.
   */
  description  String?
  /**
   * Where the chargers actually are.
   * Nullable because a city and a street line are not a position — an
   * application submitted without coordinates can still be reviewed, it just
   * cannot be put on the map. Only approved businesses that have both values
   * become map pins.
   */
  lat          Float?
  lng          Float?
  /**
   * JSON array of { connectorType, maxPowerKw, ports } from the form.
   */
  chargers     String   @default("[]")
  /**
   * pending | approved | rejected — a string, not an enum, so SQLite stays simple.
   */
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  reviews    Review[]
  dailyStats BusinessDailyStat[]

  @@index([status])
  @@index([createdAt])
}

/**
 * The Pakistan EV / PHEV / EREV catalogue.
 * Was a 145-row TypeScript module in src/data/pakistanVehicles.ts, which meant
 * adding a car needed a deploy and nothing could ever reference one by foreign
 * key. The module stays as the seed source — it is a readable, reviewable
 * record of where the list came from — but this table is what the application
 * reads.
 * Identity is required; every specification is nullable, and that is the whole
 * design. A range figure is what a driver plans a 400km trip on, so a column
 * stays NULL until somebody verifies the number rather than holding a
 * plausible guess. Eight rows have verified figures today; the other 137 are
 * honestly empty.
 * `connectors` is a comma-separated string because SQLite has no array type.
 * Read it through serialize.ts rather than splitting it at each call site.
 */
model Vehicle {
  /**
   * Kebab-case, e.g. "byd-atto-3" — stable, so it can appear in a URL.
   */
  id           String @id
  brand        String
  model        String
  /**
   * BEV | PHEV | EREV — a string, not an enum, so SQLite stays simple.
   */
  powertrain   String
  /**
   * official | imported | rare-import
   */
  availability String
  bodyType     String

  // ─── Verified figures. Null means unknown, never zero. ───
  modelYear          Int?
  rangeKm            Int?
  batteryCapacityKwh Float?
  /**
   * Comma-separated ConnectorType values, e.g. "CCS2,Type2".
   */
  connectors         String?
  dcChargingKw       Int?
  acChargingKw       Int?
  pricePkr           Int?
  imageUrl           String?

  createdAt DateTime @default(now())

  owners UserVehicle[]

  @@index([brand])
  @@index([powertrain])
  @@index([availability])
}

/**
 * A car somebody actually owns.
 * The dashboard has had an "add vehicle" screen for a while with nowhere to
 * put the answer, so a car added there survived until the next navigation.
 * User.vehicle is still there and still free text — it is what signup collects
 * in one box — and this is the structured version, pointing at a catalogue row.
 */
model UserVehicle {
  id           String   @id
  userId       String
  vehicleId    String
  /**
   * What the owner calls it, e.g. "My BYD".
   */
  customName   String?
  color        String?
  licensePlate String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@unique([userId, vehicleId])
  @@index([userId])
}

/**
 * An owners' club.
 * The home page and the clubs directory both render these, and both were
 * reading a fixture — so "234 members" was the same number for everyone,
 * forever, and Join did nothing that survived a refresh.
 * memberCount is stored rather than counted from ClubMember because the seeded
 * figures are historical totals from before this table existed; counting rows
 * would have shown every club dropping to zero. getClubs() returns the stored
 * figure plus real joins.
 */
model Club {
  id          String   @id
  name        String
  city        String
  description String
  coverPhoto  String?
  /**
   * Baseline total. Real joins live in ClubMember and are added on read.
   */
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())

  members ClubMember[]

  @@index([city])
}

model ClubMember {
  id       String   @id
  clubId   String
  userId   String
  joinedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

/// The electrified car catalogue.
///
/// Moved here from src/data/cars.ts, which is now the seed rather than the
/// source: the admin needs to edit every field, and a TypeScript module
/// compiled into the bundle cannot be written to at runtime — a production
/// filesystem is read-only, and the module the server holds is the compiled
/// one, so a successful write would change a file nobody reads until the next
/// build.
///
/// Every measured column is nullable, which is the whole point. The data
/// module's first rule is that nothing is invented: a car with no published DC
/// figure stores null, never a plausible number, and the admin form has to be
/// able to write that null back.
///
/// price is three columns rather than JSON because the catalogue sorts and
/// filters on the numbers, and `display` has to survive verbatim — "PKR 1.0649
/// Cr" is not recomputed from 10,649,000, and an indicative price carries its
/// own "(indicative)" marker inside that string.
///
/// connectors is a comma-separated string. SQLite has no array type, the value
/// is always read and written whole, and there are at most four of them; a join
/// table would cost a query per car to buy nothing.
model Car {
  id       String @id
  slug     String @unique
  brand    String
  model    String
  fullName String
  category String

  /// --- Variant identity ---------------------------------------------
  ///
  /// Added in Phase 4.1, after a crawl applied a different variant's figures to
  /// this catalogue. Before these columns existed, identity was brand + model,
  /// and variant lived inside `model` as free text: "Atto 3 Advanced", "EV9
  /// GT-Line", "Sealion 7 Advanced". That is readable and useless for matching —
  /// a source publishing variant "61.4 kWh RWD Comfort" had nothing to compare it
  /// against, so five different Seal variants all matched the one Seal row with
  /// equal confidence and the wrong one won.
  ///
  /// Deliberately nullable, and deliberately left null by the migration. Null
  /// means "this row does not declare a variant", which is a fact about all 36
  /// rows today, and the matcher treats it as exactly that: a variant-sensitive
  /// figure from a variant-declaring source is NOT applied to a row that declares
  /// none. Null does not mean "any variant".
  ///
  /// Nothing infers these. Splitting "Atto 3 Advanced" into model + variant is a
  /// judgement about what is actually sold here, so it is an edit somebody makes
  /// in the car editor, not something a migration guesses. See
  /// scripts/report-variant-identity.ts, which proposes the splits for review.
  variant    String?
  trim       String?
  /// Null means unknown, never "current year". Nothing infers this from a date.
  modelYear  Int?
  generation String?

  /// The test cycle `range` and `electricRange` were measured on.
  ///
  /// wltp | epa | cltc | nedc | jc08 | unspecified. A range without its cycle is
  /// not comparable to another range: CLTC reads roughly a third higher than WLTP
  /// for the same car, so replacing one with the other looks like a specification
  /// change and is actually a unit error. See crawler/range-standard.ts.
  rangeStandard         String?
  electricRangeStandard String?

  priceMin     Int
  priceMax     Int
  priceDisplay String

  batteryCapacity  Float?
  range            Int?
  rangeMax         Int?
  electricRange    Int?
  electricRangeMax Int?

  power        Int?
  acceleration Float?
  topSpeed     Int?
  torque       Int?
  seats        Int?

  dcCharging Float?
  acCharging Float?
  connectors String @default("")

  engineCapacity Int?

  image String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Staging rows that have been matched to this car. Read-only evidence:
  /// nothing here writes to Car, and deleting a Car nulls the link rather
  /// than destroying what a source said.
  sourceRecords   CarSourceRecord[]
  fieldChanges    CarFieldChange[]
  changeHistory   CarChangeHistory[]
  priceHistory    CarPriceHistory[]
  imageCandidates CarImageCandidate[]

  @@index([category])
  @@index([brand])
}

/**
 * ─── Crawler staging ──────────────────────────────────────────────────
 * Two tables that sit beside the catalogue and never inside it.
 * Crawled data does not go into Car. The catalogue's governing rule is that
 * nothing in it is invented, and a scraped figure is not a verified one — write
 * it straight into Car and a guess becomes indistinguishable from a supplied
 * price. So a crawl lands here, an operator reviews it, and only an approved
 * record is ever applied to a Car through the existing validated write path.
 * It also means several sources can disagree about the same car and both
 * answers survive, which a single Car row cannot express.
 */

/**
 * A provider of car data.
 * Disabled by default. Enabling a source is a decision with legal weight —
 * somebody has to have read its terms and checked its robots.txt — so the
 * schema makes that an explicit act rather than the default state.
 */
model CarSource {
  /// Kebab-case and hand-set, e.g. "pakwheels", matching the rest of this schema.
  id      String @id
  name    String @unique
  baseUrl String

  /// unchecked | allowed | disallowed | unreachable — see crawler/robots.ts.
  /// A source may only be crawled while this reads "allowed".
  robotsStatus    String    @default("unchecked")
  robotsCheckedAt DateTime?
  /// The matching robots.txt line, kept so a refusal can be justified later.
  robotsNote      String?

  /// 0–100. Higher wins when two sources disagree about the same field.
  /// A rank, not a certainty: it orders sources, it does not validate them.
  trustRank Int @default(50)

  /// How often this source may be re-crawled, and the pause between requests.
  crawlIntervalMinutes Int       @default(1440)
  requestDelayMs       Int       @default(1500)
  lastCrawledAt        DateTime?

  /// Named cadence: daily | every-3-days | weekly | monthly | manual.
  /// The interval in minutes above is derived from this, not set separately —
  /// see crawler/schedule.ts, which owns the mapping so no interval is written
  /// down twice.
  schedule String @default("daily")

  /// --- Health -------------------------------------------------------
  /// Separate from lastCrawledAt, which moves on failure too. A source that
  /// has been failing for a week has a recent lastCrawledAt and a stale
  /// lastSuccessAt, and only the second one says whether its data can be
  /// trusted.
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastError           String?
  /// Reset to zero by any success. Used to back off and to warn.
  consecutiveFailures Int       @default(0)
  /// Rolling mean, for noticing a source that is degrading rather than down.
  avgResponseMs       Int?
  /// When this source last produced data that differed from the previous crawl.
  lastChangedAt       DateTime?
  /// Days without a success before the source is called stale. Per-source
  /// because a weekly source is not stale after two days.
  staleAfterDays      Int       @default(7)

  /// --- Conditional requests ------------------------------------------
  /// The validators the source returned on the last successful fetch, replayed
  /// as If-None-Match / If-Modified-Since on the next one. A 304 then costs a
  /// few hundred bytes instead of a whole dataset, and — the part that matters
  /// more — it is the source telling us nothing changed rather than us
  /// downloading everything to work that out ourselves.
  ///
  /// Cleared on any failure. A stale validator would make a recovered source
  /// answer 304 forever, which looks exactly like a healthy source with no news.
  lastEtag         String?
  lastModifiedHttp String?

  /// The newest source-side modification timestamp seen, for APIs that accept a
  /// `modifiedSince` parameter. Distinct from lastSuccessAt, which is our clock:
  /// this one is theirs, and only theirs is safe to send back to them.
  lastSeenModified DateTime?

  /// Records to process per run, 0 for no cap. A ceiling on our own work rather
  /// than on requests — see crawler/incremental.ts for the order they are taken
  /// in, which is what makes a capped run still cover what matters.
  recordBudget Int @default(0)

  /// Off until somebody turns it on deliberately.
  isEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records CarSourceRecord[]

  @@index([isEnabled])
}

/**
 * One page, from one source, as read on one crawl run.
 * ── The unique constraint, and what it deliberately does not assume ───
 * `@@unique([sourceId, sourceUrl, runId])`.
 * A source's car name is not unique, its slug is not unique, and neither is
 * safe as an identity — two sources will both call something "Atto 3", and one
 * source may list the same car under several names. The only thing that
 * identifies a page is its URL, and only within the source that served it.
 * `runId` is in the key on purpose: it makes re-crawls accumulate as history
 * rather than overwrite, so "this price changed last Tuesday" is answerable,
 * while a run that visits the same URL twice still cannot insert it twice.
 */
model CarSourceRecord {
  id String @id

  sourceId String
  source   CarSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// The exact page this was read from.
  sourceUrl  String
  /// The source's own identifier, when it publishes one. Never assumed present,
  /// never assumed unique across sources.
  externalId String?

  /// --- Identity as the source published it -------------------------
  ///
  /// Lifted out of the normalised payload rather than left only inside it, so the
  /// review queue can show which variant a figure came from without parsing JSON,
  /// and so "which variants of this model did we see?" is a query.
  ///
  /// This data was always in the payload. openev publishes variant
  /// "61.4 kWh RWD Comfort" and a release year for the Seal, and the matcher
  /// ignored both — which is how an 87 kWh record and a 61.4 kWh record became
  /// indistinguishable claims about one car.
  variant    String?
  trim       String?
  modelYear  Int?
  generation String?

  /// proven | unproven | ambiguous | mismatch — see crawler/identity.ts.
  ///
  /// Whether the VARIANT was established, which is a separate question from
  /// whether the model matched. A record can match the right car and still have
  /// an unproven variant, and that is the case that caused Phase 4.1.
  variantVerdict String?
  /// Which identity tier decided it, e.g. "brand-model-variant-year".
  identityTier   String?

  /// Groups every record produced by a single crawl.
  runId      String
  fetchedAt  DateTime
  httpStatus Int?

  /// ScrapedCar, as JSON text — SQLite has no JSON column, and this project
  /// already stores whole-read blobs this way (see serialize.ts).
  raw         String
  /// NormalisedCar, as JSON text. Null when normalisation could not run.
  normalised  String?
  /// Hash of `raw`, so an unchanged re-crawl is recognisable without a diff.
  contentHash String

  /// ok | partial | failed
  extractionStatus String @default("ok")
  fieldsFound      Int    @default(0)
  fieldsExpected   Int    @default(0)
  /// 0–100, derived from field coverage and how the values were obtained.
  confidence       Int    @default(0)

  /// pending | approved | rejected | superseded | duplicate
  reviewStatus String    @default("pending")
  reviewedAt   DateTime?
  reviewNote   String?

  /// Set only by the matcher, and only ever as a proposal. Phase 1 never
  /// applies a record to a Car.
  matchedCarId    String?
  matchedCar      Car?    @relation(fields: [matchedCarId], references: [id], onDelete: SetNull)
  /// external-id | slug | exact | strong | none — see crawler/match.ts.
  matchStrategy   String?
  matchScore      Int?
  /// Serialised rival candidates, so an ambiguous match can be reviewed rather
  /// than silently resolved.
  matchCandidates String?

  /// Why extraction or normalisation failed, when it did.
  errorMessage String?
  /// Field names that could not be read, as JSON text.
  errorFields  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, sourceUrl, runId])
  @@index([sourceId, externalId])
  @@index([reviewStatus, fetchedAt])
  @@index([matchedCarId, fetchedAt])
  @@index([runId])
  @@index([contentHash])
}

/**
 * One execution of one source's crawl.
 * `CarSourceRecord.runId` holds this id, but deliberately as a plain string
 * rather than a foreign key. Adding a real relation would mean altering
 * CarSourceRecord, and the standing constraint on this project is that crawler
 * migrations stay additive — a CREATE TABLE cannot damage a live catalogue, an
 * ALTER can. The cost is that a run row could in principle be deleted while its
 * records remain; the records are the valuable half, so that is the right way
 * round.
 */
model CrawlRun {
  id       String @id
  sourceId String

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// running | completed | partial | failed | aborted | blocked
  /// "blocked" is its own outcome, not a failure: it means robots.txt or a
  /// missing credential stopped the run before a single request went out, which
  /// is the system working rather than breaking.
  /// "partial" means some records failed and some arrived. It is not a failure
  /// either: the source is plainly reachable, so treating it as one would put a
  /// working source into backoff over a single bad record.
  status String @default("running")

  recordsFound         Int @default(0)
  recordsStored        Int @default(0)
  recordsFailed        Int @default(0)
  /// Records whose content hash differed from the last stored one.
  recordsChanged       Int @default(0)
  /// Records byte-identical to the previous crawl. The common case on a
  /// daily schedule, and the reason a run can be cheap.
  recordsUnchanged     Int @default(0)
  /// Proposals this run put in front of a person.
  recordsPendingReview Int @default(0)
  /// New-car candidates raised.
  candidatesFound      Int @default(0)

  /// scheduled | manual. Kept so an unexpected run can be traced to whoever
  /// or whatever started it.
  trigger    String @default("manual")
  durationMs Int?

  /// Collected failures as JSON text, so one bad page does not lose the run.
  errors String?
  notes  String?

  @@index([sourceId, startedAt])
  @@index([status])
}

/**
 * --- Review, history and provenance ----------------------------------
 * Four tables between a crawled record and the catalogue.
 * A source record is normalised, matched to a Car, then compared field by
 * field against what that Car holds. Each difference becomes one
 * CarFieldChange -- a proposal, never an edit. An operator approves or rejects
 * it; approval writes the field through the existing validated path and leaves
 * a CarChangeHistory row, so "why does this car show this figure?" always has
 * an answer.
 * Prices and images get their own tables because both need history rather than
 * a current value: a price that changed in March is not wrong, it is previous,
 * and an image carries a licence that must outlive the image being replaced.
 */

/**
 * One proposed change to one field of one car.
 * The unit of review. A record differing in twelve fields produces twelve of
 * these, so an operator can take the battery figure and refuse the price rather
 * than being forced to accept both.
 * Values are text, not typed columns. A change may concern a number, a string, a
 * boolean or a list, and what matters is the pair a reviewer reads side by side.
 */
model CarFieldChange {
  id String @id

  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  /// The staging row this came from, so raw data stays reachable.
  recordId String
  sourceId String
  runId    String

  /// The field on Car, e.g. "batteryCapacity".
  field String

  currentValue  String?
  proposedValue String?
  /// Exactly what the source published, before unit normalisation.
  rawValue      String?
  unit          String?

  /// new | changed | unchanged | missing | conflicting | suspicious
  /// | unit-mismatch | source-disagreement
  changeType String

  /// safe | review | high-risk. Nothing is applied automatically, including
  /// "safe": the label orders a queue, it does not grant permission.
  riskLevel String @default("review")

  /// 0-100, with the reasoning kept beside it rather than only the number.
  confidence        Int     @default(0)
  confidenceReasons String?

  /// Serialised per-source opinions, so a conflict shows every claim.
  opinions String?

  /// Validation problems found on the proposed value.
  validationFlags String?

  /// --- Variant evidence -------------------------------------------
  ///
  /// Carried onto the proposal so the review screen can say WHICH variant a
  /// figure describes, beside the value. The five changes that prompted Phase 4.1
  /// were approved from a queue that said "sources disagree" — true in that the
  /// numbers differed, and misleading in that it was one source describing five
  /// different cars. A reviewer shown "61.4 kWh RWD Comfort" next to
  /// "U 87 kWh Design" would not have approved.
  variantVerdict  String?
  identityTier    String?
  sourceVariant   String?
  sourceModelYear Int?

  /// True when this field's value depends on which variant is being described.
  /// Battery, range, power and price are; seat count is usually not. Such a field
  /// is never applied while the variant is unproven.
  variantSensitive Boolean @default(false)

  /// Test cycles either side of a range change, so 425 unspecified cannot quietly
  /// replace 650 CLTC.
  currentRangeStandard  String?
  proposedRangeStandard String?

  /// pending | approved | rejected | superseded
  status     String    @default("pending")
  reviewedAt DateTime?
  reviewedBy String?
  reviewNote String?

  sourceUrl String
  fetchedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One proposal per car+field+source+run. A later run proposing the same
  /// field is a new row, so what each source claimed over time survives.
  @@unique([carId, field, sourceId, runId])
  @@index([status, confidence])
  @@index([carId, field])
  @@index([riskLevel, status])
  @@index([changeType])
}

/**
 * What was actually applied, and by whom.
 * Append-only. This is the trail that answers "why does this car show this
 * specification?", so nothing here is updated or deleted -- a mistake is
 * corrected by a further change with its own row, not by editing the record of
 * the mistake.
 */
model CarChangeHistory {
  id String @id

  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  field    String
  oldValue String?
  newValue String?

  sourceId  String?
  sourceUrl String?
  /// The proposal this came from. Null for a hand edit.
  changeId  String?

  approvedBy String
  approvedAt DateTime @default(now())
  reason     String?

  @@index([carId, approvedAt])
  @@index([field])
}

/**
 * A price, as it stood at a moment, in a market.
 * Separate from Car.priceMin because a Pakistani price is a time series, not a
 * fact: rupee prices move with the budget, the exchange rate and each
 * assembler's revisions. Never overwritten -- a new price is a new row.
 */
model CarPriceHistory {
  id String @id

  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  /// Whole units of `currency`. Rupees, not paisa.
  price    Int
  currency String @default("PKR")
  /// Market code, so a PKR price and a CNY one cannot be compared by accident.
  market   String @default("PK")

  /// ex-factory | on-road | announced | indicative. A price without its basis
  /// is not comparable to another price.
  priceType String @default("indicative")

  sourceId      String?
  sourceUrl     String?
  fetchedAt     DateTime
  /// When the price took effect, if stated. Often unknown.
  effectiveDate DateTime?

  confidence Int     @default(0)
  note       String?

  createdAt DateTime @default(now())

  @@index([carId, fetchedAt])
  @@index([carId, market, fetchedAt])
}

/**
 * An externally-found image and its licence, before anyone publishes it.
 * Nothing here is served. The catalogue reads Car.image, and a candidate becomes
 * that only after approval and after a person deliberately places the file.
 * The licence fields are the point: /images/cars holds Commons files whose
 * attribution lives in src/data/carImageCredits.ts, and an unlicensed image
 * landing there would break that credit and put uncredited work on a commercial
 * site.
 */
model CarImageCandidate {
  id String @id

  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  /// Where the file lives remotely. Never fetched on discovery.
  imageUrl  String
  /// The page it was found on.
  sourceUrl String
  sourceId  String?

  /// Licence as published. Null means unknown, which is a reason to refuse.
  licence     String?
  licenceUrl  String?
  attribution String?

  fetchedAt  DateTime
  /// pending | approved | rejected. Approval does not publish it.
  status     String    @default("pending")
  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())

  @@unique([carId, imageUrl])
  @@index([status])
}

/**
 * A car a source described that the catalogue does not have.
 * Never becomes a Car on its own. Discovery raises a candidate; a person
 * approves it, rejects it, or merges it into an existing car — because the
 * alternative is a crawler inventing catalogue entries from a name it could not
 * match, which is the most damaging thing this pipeline could do.
 * `possibleDuplicateOf` is the near-miss the matcher found but would not commit
 * to. A source calling something "Atto 3" when the catalogue holds "Atto 3
 * Advanced" belongs here, flagged, rather than either silently merged or
 * silently added as a second car.
 */
model CarCandidate {
  id String @id

  sourceId String
  runId    String
  /// The staging row this came from, so the raw data stays reachable.
  recordId String

  brand     String
  model     String
  variant   String?
  trim      String?
  modelYear Int?
  category  String?

  /// The whole normalised vehicle, as JSON text.
  normalised String

  /// A car this might actually be. Set when the matcher found a near miss.
  possibleDuplicateOf String?
  duplicateReason     String?
  /// 0-100 from the matcher. Never high enough on its own to merge.
  matchScore          Int?

  confidence Int @default(0)

  /// pending | approved | rejected | merged
  status     String    @default("pending")
  reviewedAt DateTime?
  reviewNote String?
  /// Set when an operator merged this into an existing car.
  mergedInto String?

  sourceUrl String
  fetchedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One candidate per source identity. A daily crawl re-seeing the same
  /// unmatched car updates it rather than stacking a new row every morning.
  @@unique([sourceId, brand, model, variant, modelYear])
  @@index([status, confidence])
  @@index([possibleDuplicateOf])
}

/**
 * Structured log lines from a crawl.
 * A table rather than a file, because the questions asked of these are queries:
 * "what did this source do last Tuesday", "which car failed twice this week".
 * A log file would need grepping from a machine nobody is sitting at.
 * NOTHING SECRET IS EVER WRITTEN HERE. No API keys, no tokens, no passwords,
 * no Authorization headers. crawler/logger.ts redacts before this is reached,
 * and the redaction is tested — a log table is exactly the kind of place a
 * credential leaks into and stays.
 */
model CrawlLogEntry {
  id String @id

  runId    String
  sourceId String
  /// The car or record this line concerns, when it concerns one.
  carId    String?

  /// fetch | normalise | match | compare | propose | discover | skip | error
  operation String
  /// ok | unchanged | changed | failed | blocked | skipped
  status    String

  message    String?
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([runId, createdAt])
  @@index([sourceId, status, createdAt])
}
